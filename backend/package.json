{
  "name": "chhanni-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "db:start": "node --env-file-if-exists=../.env scripts/db-server.js",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "db:reset": "node --env-file-if-exists=../.env scripts/migrate.js --reset",
    "db:seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "demo:rehearse": "node --env-file-if-exists=../.env scripts/demo-rehearsal.js",
    "test": "node --env-file-if-exists=../.env scripts/run-tests.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  }
}
